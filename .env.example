# ── ProHarness configuration ──────────────────────────────────────────────────
# Copy to .env and edit. All values have sensible defaults so the harness runs
# fully local with no cloud keys.

# MCP discovery: full preserves all 58 tools; library exposes Find, Open,
# Memory, Collection, Import and Status for source-backed work.
# With --with-library-ui, /mcp/library always provides library discovery using
# the same runtime. This setting controls /mcp (or standalone stdio) only.
PROHARNESS_MCP_TOOL_PROFILE=full

# Shared library service only (--with-library-ui): cooperative background upkeep
# of an already installed compatible catalog index, if ARCHIVE_CATALOG_INDEX=true.
# No automatic index installation/rebuild, fact edits, ranking tuning, source
# extraction, or provider/embedding calls. Status diagnostics are process-local.
PROHARNESS_LIBRARY_MAINTENANCE_ENABLED=true
PROHARNESS_LIBRARY_MAINTENANCE_INTERVAL_SECONDS=300
# Rows per interval (1..128); yields to foreground locks and busy writers.
PROHARNESS_LIBRARY_MAINTENANCE_BATCH_SIZE=32

# ── Model providers ───────────────────────────────────────────────────────────
# Cloud (any subset is fine; only the ones with keys will be used)
OPENAI_API_KEY=

# Any Anthropic-Messages-compatible endpoint: Anthropic itself, Z.ai/Zhipu GLM
# (https://api.z.ai/api/anthropic), Amazon Bedrock, etc. The internal client
# speaks the Messages *protocol* — vendor-neutral. The legacy ANTHROPIC_API_KEY
# name still works as an alias for MESSAGES_API_KEY.
#
# Example: Z.ai/Zhipu GLM coding plan (use YOUR OWN key — never reuse a key
# licensed to another client like ZCode's coding-plan subscription):
#   PROHARNESS_MESSAGES_API_KEY=your-z.ai-key
#   PROHARNESS_MESSAGES_API_BASE_URL=https://api.z.ai/api/anthropic
#   PROHARNESS_MESSAGES_API_MODELS=GLM-5.2,glm-5-turbo
#   PROHARNESS_CLOUD_MODEL=GLM-5.2
#   PROHARNESS_CHEAP_MODEL=glm-5-turbo
PROHARNESS_MESSAGES_API_KEY=
PROHARNESS_MESSAGES_API_BASE_URL=https://api.anthropic.com/v1
# Comma-separated model ids that route through the Messages client. A model
# starting with `claude-` is always routed there as a back-compat default.
PROHARNESS_MESSAGES_API_MODELS=

# Local LLM via llama.cpp server (OpenAI-compatible API).
# Start one with:  ./server -m model.gguf --port 8080
LLAMA_BASE_URL=http://localhost:8080/v1

# ── Model registry (which model id each tier maps to) ────────────────────────
# local model is whatever llama.cpp is serving; cloud tiers use provider names.
PROHARNESS_LOCAL_MODEL=local
PROHARNESS_CHEAP_MODEL=gpt-4o-mini
PROHARNESS_CLOUD_MODEL=gpt-4o

# ── Pipelines ────────────────────────────────────────────────────────────────
# Default per-run token budget for pipelines without an explicit token_budget.
# 0 = unlimited. Past 80% consumed, model.invoke tiers degrade one step
# (cloud→cheap→local, honoring each node's tier_floor) to preserve completion.
PROHARNESS_PIPELINE_DEFAULT_BUDGET=0

# ── Router ────────────────────────────────────────────────────────────────────
# Single-shot routing threshold α ∈ [0,1]. Lower = more aggressive use of cloud.
# (RouteLLM: α is the cost/quality knob.)
PROHARNESS_ROUTER_ALPHA=0.55
# Hard rule: if the input is under this many chars AND matches the trivial
# regex, always route to local.
PROHARNESS_ROUTER_TRIVIAL_MAX_CHARS=120

# ── Memory ───────────────────────────────────────────────────────────────────
# Qdrant on the NAS (HTTP). docker/nas/docker-compose.yml deploys it.
QDRANT_URL=http://nas.local:6333
QDRANT_COLLECTION=proharness_memories
QDRANT_API_KEY=

# SQLite source-of-truth. Put on a NAS-mounted volume for remote durability.
PROHARNESS_SQLITE_PATH=/Volumes/ProHarness/proharness.db

# Embedding model. bge-small-en-v1.5 = 384-dim, fast, runs in-process.
# Alternatives: nomic-embed-text-v1.5 (768), BAAI/bge-m3 (sparse+dense).
PROHARNESS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Park scoring weights (recency, importance, relevance). Equal default.
PROHARNESS_RECENCY_WEIGHT=1.0
PROHARNESS_IMPORTANCE_WEIGHT=1.0
PROHARNESS_RELEVANCE_WEIGHT=1.0
PROHARNESS_RECALL_TOPK=8
# Consolidation: cosine threshold above which an insert is treated as a
# potential duplicate / contradiction (Mem0 pattern).
PROHARNESS_DEDUP_COSINE=0.90

# ── Reflection / continual learning (ideas #1, #2, #3) ────────────────────────
# Park 2023 importance-threshold trigger: reflection runs when cumulative
# importance of recent inserts crosses this (0 → cron-only fallback).
PROHARNESS_REFLECT_IMPORTANCE_THRESHOLD=30.0
# Rehearsal window (GEM/Chaudhry): N most-recent episodic memories always
# prepended to recall each turn (0 → disabled). Small token cost; see
# docs/research.md for the cost/continuity tradeoff.
PROHARNESS_REHEARSAL_WINDOW=3

# Explicitly pinned standing facts; 0 disables the core block (maximum 4096).
PROHARNESS_CORE_MEMORY_MAX_TOKENS=512
# Whole, exact document passages automatically added to agent/worker context.
# The main agent further reduces this for its model window. 0 disables priming;
# evidence and document tools remain available. Sensitive sources are excluded.
PROHARNESS_DOCUMENT_CONTEXT_MAX_TOKENS=768
PROHARNESS_DOCUMENT_CONTEXT_TOP_K=3
# Archive retrieval: exhaustive keeps full eligible-chunk recall; bounded
# scores the full eligible scope in SQL and limits hydrated candidates. Default
# stays exhaustive; candidate truncation is reported in search diagnostics.
PROHARNESS_ARCHIVE_SEARCH_POLICY=exhaustive
# Maximum hydrated/reranked candidates per bounded request (30..2048).
# The cap can underfill results when candidates contain many overlapping spans.
PROHARNESS_ARCHIVE_CANDIDATE_BUDGET=128
# Optional exact-token metadata index for source_discovery and filtered document
# listings. Lazy build adds SQLite storage; native scan remains the fallback.
PROHARNESS_ARCHIVE_CATALOG_INDEX=false
# Citation resolution is always available. Optional local claim-support check;
# unverified or unsupported personal answers are excluded from answer caching.
PROHARNESS_ATTRIBUTION_JUDGE=false

# Optional original PDF page images; install .[document-view]. No OCR or models.
# Omit to use the server interpreter; configure an absolute executable path to
# a separate render-only environment when desired. Workers exit after each page.
# PROHARNESS_PAGE_IMAGE_PYTHON=/absolute/path/to/render-environment/bin/python

# Optional PDF layout/table/OCR recovery; explicitly selected docling backend.
# Keep the server on its existing interpreter. Setup: docs/document-recovery.md.
# Omit PROHARNESS_DOCLING_PYTHON to use the current interpreter; when set it
# must be an absolute executable path. The OCR venv only needs Docling/EasyOCR.
# PROHARNESS_DOCLING_PYTHON=/absolute/path/to/proharness/.venv-docling/bin/python
# PROHARNESS_DOCLING_ARTIFACTS=/absolute/path/to/proharness/.docling-models
# The worker forces offline variables and blocks Python socket connections;
# this dependency guard is not an OS network sandbox.

# ── Voice ─────────────────────────────────────────────────────────────────────
# faster-whisper model size: tiny|base|small|medium|large-v3
PROHARNESS_WHISPER_MODEL=base
PROHARNESS_WHISPER_DEVICE=cpu        # or cuda / metal
PROHARNESS_WHISPER_COMPUTE=int8      # int8|float16|float32
# TTS backend: none|piper|openai
PROHARNESS_TTS=none

# ── Cost tracking ─────────────────────────────────────────────────────────────
# USD per 1M tokens. Adjust as pricing changes.
PROHARNESS_PRICE_LOCAL=0.0
PROHARNESS_PRICE_GPT4O_MINI_IN=0.15
PROHARNESS_PRICE_GPT4O_MINI_OUT=0.60
PROHARNESS_PRICE_GPT4O_IN=2.50
PROHARNESS_PRICE_GPT4O_OUT=10.00

# Experimental Find relevance policies; legacy remains the tested default.
# original: preserve question wording for document retrieval.
# coverage: also apply weighted term coverage and conservative reference deferral.
# These trials did not pass all quality/latency gates; see docs/find-relevance-20261014.md.
PROHARNESS_LIBRARY_FIND_RELEVANCE_POLICY=legacy

# Find presentation controls (independent of retrieval ranking).
# focused: weak bodies and heading-only navigation become exact Open references.
# all: legacy body allocation; body_first: earlier conservative metadata deferral.
PROHARNESS_LIBRARY_FIND_DELIVERY_POLICY=all
# Compact public framing and identical-provenance references; whole quotes unchanged.
PROHARNESS_LIBRARY_FIND_COMPACT=false
# Experimental source-backed relationship navigation. Keep off until your paired
# quality/resource evaluation passes. Does not add a query-time writing model.
PROHARNESS_LIBRARY_FIND_RELATIONSHIPS=false
