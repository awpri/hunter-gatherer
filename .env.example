# hunter/gatherer advanced configuration reference
# The ordinary workflow needs no config file:
#   hunt init ./my-library
#   hunt serve ./my-library --port 8767
# --library and demo workflows use isolated manifest settings and ignore this file.
# For advanced configured-store commands, copy to ~/.hunter-gatherer/config.env
# or explicitly select a file using HG_CONFIG_FILE=/absolute/path/config.env.
# A checkout's .env and PROHARNESS_ variables are not loaded automatically.

# Lean defaults: SQLite records/keyword search plus lightweight local hashing.
# Relative database paths resolve under ~/.hunter-gatherer, not the working folder.
HG_SQLITE_PATH=library.db
HG_VECTOR_BACKEND=memory
HG_EMBED_MODEL=hashing
HG_LOCAL_ONLY=true
HG_MCP_TOOL_PROFILE=library

# For a NEW semantic library, install .[semantic], then use:
#   hunt init ./semantic-library --semantic --download-model
# Omit --download-model to require existing cached weights.
# Do not switch a populated store's embedding model without a backup/rebuild.
# Advanced configured-store semantic settings:
# HG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# HG_EMBED_LOCAL_FILES_ONLY=true

# Optional Qdrant memory-vector index: install .[qdrant] and run your own server.
# Document passages and source records remain in SQLite. No automatic setup.
# HG_VECTOR_BACKEND=qdrant
# HG_QDRANT_URL=http://127.0.0.1:6333
# HG_QDRANT_COLLECTION=hg_memories
# HG_QDRANT_API_KEY=

# Source retrieval and presentation; avoid experimental policies without evaluation.
HG_ARCHIVE_SEARCH_POLICY=exhaustive
HG_ARCHIVE_CANDIDATE_BUDGET=128
HG_ARCHIVE_CATALOG_INDEX=false
HG_LIBRARY_FIND_RELEVANCE_POLICY=legacy
HG_LIBRARY_FIND_DELIVERY_POLICY=all
HG_LIBRARY_FIND_COMPACT=false
HG_LIBRARY_FIND_RELATIONSHIPS=false

# Optional background upkeep of an already installed compatible catalog index.
# Does not install models, change facts or rebuild an index automatically.
HG_LIBRARY_MAINTENANCE_ENABLED=false
HG_LIBRARY_MAINTENANCE_INTERVAL_SECONDS=300
HG_LIBRARY_MAINTENANCE_BATCH_SIZE=32

# Optional original PDF rendering: install .[document-view]. No OCR/model download.
# Omit to use the server interpreter; an override must be an absolute executable.
# HG_PAGE_IMAGE_PYTHON=/absolute/path/to/render-env/bin/python

# Advanced OCR/layout recovery: install .[document-recovery] and prepare models.
# HG_DOCLING_PYTHON=/absolute/path/to/ocr-env/bin/python
# HG_DOCLING_ARTIFACTS=/absolute/path/to/ocr-models

# Optional agent runtime only; normal Ask/MCP retrieval does not generate answers.
# Keep secrets out of Git. Conventional provider credential aliases also exist.
# HG_OPENAI_API_KEY=
# HG_MESSAGES_API_KEY=
# HG_MESSAGES_API_BASE_URL=https://api.anthropic.com/v1
# HG_MESSAGES_API_MODELS=
# HG_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# Set provider model IDs and current pricing deliberately for your chosen runtime.
# HG_LOCAL_MODEL=local
# HG_CHEAP_MODEL=
# HG_CLOUD_MODEL=

# Optional audio runtime; no microphone flow is enabled in the library UI.
# HG_WHISPER_MODEL=base
# HG_WHISPER_DEVICE=cpu
# HG_WHISPER_COMPUTE=int8
# HG_TTS=none

# All advanced fields and defaults are documented in hunter_gatherer/config.py.
